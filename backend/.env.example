############################################
# Backend — Exemplo de variáveis de ambiente
# Copie para .env e ajuste conforme o ambiente
#   Dev: mantenha PIX_STUB=true e não defina MP_ACCESS_TOKEN
#   Produção: defina MP_ACCESS_TOKEN e use PIX_STUB=false
#
# Observação: o frontend em dev usa proxy do Vite para '/api'
#             apontando para http://localhost:4000. Mantenha PORT=4000
#             ou atualize o proxy em frontend/vite.config.js.
############################################

# Porta do servidor Express (alinha com o proxy do Vite)
PORT=4000

# Prisma — escolha entre SQLite (testes) ou PostgreSQL (produção)
#
# Testes/Dev com SQLite (recomendado para PIX stub e ambiente efêmero):
# Define um arquivo local do SQLite. Em Render (free), o sistema de arquivos
# é efêmero; use apenas para validações e demonstrações.
DATABASE_URL="file:./src/prisma/dev.db"
#
# Produção com PostgreSQL (persistência real):
# Exemplo (Render External URL):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
# Exemplo (Docker local):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Stub de PIX (simula Mercado Pago em desenvolvimento)
PIX_STUB=true

# Token real do Mercado Pago (produção)
MP_ACCESS_TOKEN=

# URL do microsserviço de disponibilidade (opcional)
AVAILABILITY_URL=http://localhost:4100

# Lista de origens permitidas para CORS (produção)
# Ex.: CORS_ALLOWED_ORIGINS=https://seusite.netlify.app,https://app.seudominio.com
CORS_ALLOWED_ORIGINS=
