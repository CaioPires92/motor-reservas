{
    "name": "hotel-frontend",
    "version": "1.0.0",
    "private": true,
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm:dev\" \"npm --prefix ../backend run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:e2e:dev": "start-server-and-test dev:full http://localhost:5173 test:e2e",
    "report:e2e": "mochawesome-merge cypress/reports/.jsons/*.json -o cypress/reports/mochawesome.json && marge cypress/reports/mochawesome.json -f index -o cypress/reports"
  },
    "dependencies": {
        "axios": "^1.4.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
  "devDependencies": {
    "vite": "^4.3.9",
    "cypress": "^13.0.0",
    "tailwindcss": "^3.3.3",
    "start-server-and-test": "^2.0.0",
    "concurrently": "^8.2.2",
    "cypress-mochawesome-reporter": "^3.5.1",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.0.1"
  }
}
