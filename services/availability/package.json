{
    "name": "availability-service",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "dev": "node src/server.js",
        "test": "cross-env DATABASE_URL=\"file:./test.db\" prisma db push --schema prisma/schema.prisma && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
        "prisma:generate": "prisma generate --schema prisma/schema.prisma",
        "prisma:push": "prisma db push --schema prisma/schema.prisma",
        "db:seed": "node prisma/seed.js"
    },
    "dependencies": {
        "@prisma/client": "^5.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2"
    },
    "devDependencies": {
        "jest": "^29.0.0",
        "prisma": "^5.0.0",
        "supertest": "^6.3.3",
        "cross-env": "^7.0.3"
    }
}